# ==========================================================
# Escolha UM dos dois modos (ou nenhum, e tudo fica no aparelho)
# ==========================================================

# 1) Servidor de casa: SQLite rodando na sua máquina (npm run servidor).
#    O próprio servidor imprime estas duas linhas quando sobe.
#    Funciona com os dois celulares no mesmo Wi-Fi.
VITE_API_URL=http://192.168.0.10:8787
VITE_API_CHAVE=cole-a-chave-que-o-servidor-mostrou

# 2) Supabase: funciona em qualquer lugar, inclusive na rua.
#    Rode supabase/schema.sql no projeto e cole as chaves aqui.
# VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica
