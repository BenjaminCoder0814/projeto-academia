# ==========================================================
# Nuvem (Supabase) — é o que vale em produção (Vercel/Netlify)
# ==========================================================
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-publishable-ou-anon

# ==========================================================
# Alternativas para desenvolvimento — NÃO use em produção
# ==========================================================
# Servidor SQLite na sua máquina (npm run servidor). Só funciona
# com os celulares no mesmo Wi-Fi, então não vale num deploy.
# VITE_API_URL=http://192.168.0.10:8787
# VITE_API_CHAVE=cole-a-chave-que-o-servidor-mostrou
#
# Sem nenhuma variável, o app guarda tudo no próprio aparelho
# (IndexedDB), com backup exportável na aba Nós.
